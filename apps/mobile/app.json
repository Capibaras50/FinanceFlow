{
  "expo": {
    "name": "Finance Flow",
    "slug": "finance-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "finance-flow",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Finance Flow necesita acceso a la cámara para escanear recibos.",
        "NSPhotoLibraryUsageDescription": "Finance Flow necesita acceso a la galería para seleccionar imágenes de recibos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.financeflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1326",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.financeflow.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Finance Flow necesita acceso a la cámara para escanear recibos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finance Flow necesita acceso a la galería para seleccionar imágenes de recibos."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "./plugins/withCleartextTraffic"
    ],
    "extra": {
      "eas": {
        "projectId": "170d9b99-e603-42f4-9008-4d8e8edca863"
      }
    },
    "owner": "capibaras60",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/170d9b99-e603-42f4-9008-4d8e8edca863"
    }
  }
}
